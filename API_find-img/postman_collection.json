{
  "info": {
    "name": "Logo Selection API - New Flow",
    "description": "API workflow: Logo → Color → Layout → Background → Customize → Export",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "version": "2.0.0"
  },
  "item": [
    {
      "name": "1. Initialize Session",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "// Auto-save sessionId to collection variable",
              "if (pm.response.code === 200 || pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.success && jsonData.data.sessionId) {",
              "        var sessionId = jsonData.data.sessionId;",
              "        ",
              "        // Save to collection variable (preferred)",
              "        pm.collectionVariables.set('sessionId', sessionId);",
              "        ",
              "        // Also save to environment if exists",
              "        if (pm.environment.name) {",
              "            pm.environment.set('sessionId', sessionId);",
              "        }",
              "        ",
              "        console.log('✅ SessionId saved:', sessionId);",
              "        console.log('✅ You can now run the next steps!');",
              "    }",
              "}",
              "",
              "// Show test result",
              "pm.test('Session initialized successfully', function() {",
              "    pm.expect(pm.response.code).to.be.oneOf([200, 201]);",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.data.sessionId).to.exist;",
              "    pm.expect(jsonData.data.logos).to.be.an('array');",
              "    pm.expect(jsonData.data.logos.length).to.be.above(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"session_id\": \"62e3f3d3\",\n  \"dealer_id\": \"0986899001\",\n  \"brand_name_full\": \"Nhôm kính An Phát\",\n  \"location\": \"212 Quang Trung, Hà Đông, Hà Nội\",\n  \"business_model\": \"Vừa sản xuất vừa thương mại\",\n  \"main_products\": [\n    \"cửa nhôm\",\n    \"cửa kính\",\n    \"vách ngăn\",\n    \"cửa cuốn\",\n    \"phụ kiện\"\n  ],\n  \"main_services\": [],\n  \"product_portfolio\": [\n    \"cửa nhôm\",\n    \"cửa kính\",\n    \"vách ngăn\",\n    \"cửa cuốn\",\n    \"phụ kiện\"\n  ],\n  \"target_customers\": [\n    \"hộ gia đình\",\n    \"chủ thầu xây dựng\",\n    \"dự án lớn\"\n  ],\n  \"competitive_advantage\": [\n    \"tay nghề thợ cao\",\n    \"sản phẩm chất lượng\",\n    \"giá thành cạnh tranh\"\n  ],\n  \"core_values\": [\n    \"Uy tín\",\n    \"Chất lượng\",\n    \"Tận tâm\"\n  ],\n  \"slogan\": \"An Phát – Uy Tín Kiến Tạo, Chất Lượng Dẫn Đầu.\",\n  \"future_vision\": [\n    \"Uy tín kiến tạo\",\n    \"Chất lượng dẫn đầu\"\n  ],\n  \"logo_style\": [\n    \"Hiện đại (Modern Geometric)\"\n  ],\n  \"main_color\": [\n    \"xanh dương\"\n  ],\n  \"revenue\": \"200 triệu đồng/tháng\",\n  \"logo_shape\": [\n    \"cách điệu từ tên thương hiệu An Phát\"\n  ]\n}"
        },
        "url": {
          "raw": "http://localhost:3000/api/workflow/initialize",
          "protocol": "http",
          "host": ["localhost"],
          "port": "3000",
          "path": ["api", "workflow", "initialize"]
        },
        "description": "Initialize session and get logo list (original color)"
      },
      "response": []
