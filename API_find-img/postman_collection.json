      "description": "⚠️ AUTO-FILLED: Run 'Initialize Session' first, sessionId will be saved automatically"
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// Check if sessionId exists",
          "if (!pm.collectionVariables.get('sessionId') && !pm.environment.get('sessionId')) {",
          "    console.warn('⚠️ No sessionId found! Run \"1. Initialize Session\" first.');",
          "}"
        ]
      }
    }
  ]
